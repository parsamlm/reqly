---
import Site from '../layouts/Site.astro';
import icon from '../assets/icon.png?url';
import { links } from '../links';

const features = [
	{
		title: 'Capture with one switch.',
		text: "Start capturing, and Reqly becomes your computer's proxy. Stop, quit or even crash, and your network settings come back.",
	},
	{
		title: 'Decrypt only what you choose.',
		text: 'Pick the hosts to decrypt. Everything else passes through untouched.',
	},
	{
		title: 'Read every request.',
		text: 'See which app sent what, with headers, cookies, bodies and timing. JSON, XML, images and more are formatted for you.',
	},
	{
		title: 'Find it fast.',
		text: 'Search URLs, headers and bodies. Filter by app, device, host or status, and pin what matters.',
	},
	{
		title: 'Change traffic as it passes.',
		text: 'Pause a request at a breakpoint and edit it. Answer it with a local file, send it to another server, rewrite it, block it, or slow the network down to 3G.',
	},
	{
		title: 'Script it.',
		text: "Write JavaScript that rewrites requests and responses, or answers them itself. Scripts can't reach your files or the network.",
	},
	{
		title: 'Phones and emulators.',
		text: 'Connect a phone or tablet on the same Wi-Fi with a QR code. Android emulators are set up for you, and on the Mac, iOS Simulators too.',
	},
	{
		title: 'Modern protocols.',
		text: 'HTTP/2, WebSocket, and gRPC and Protobuf decoded into readable fields.',
	},
	{
		title: 'Save and share.',
		text: 'Save a session and open it on a Mac or a PC. Export HAR files with secrets hidden, and copy any request as cURL.',
	},
	{
		title: 'Made for the Mac and Windows.',
		text: "Each app uses its system's own controls, follows light and dark mode, and has keyboard shortcuts. On the Mac, VoiceOver works throughout.",
	},
];

const next = [
	{
		title: 'Windows 1.0',
		text: "Out of beta, with a signed installer, and in winget, Windows' package manager.",
	},
	{
		title: 'Linux',
		text: 'The same app for Debian, Ubuntu and the systems based on them, kept up to date with apt.',
	},
	{
		title: 'iPhone and iPad',
		text: "A companion app that sends a device's traffic to Reqly on a Mac or a PC in a few taps.",
	},
	{
		title: 'Android',
		text: 'The same companion app, which also shows which app made each connection.',
	},
];
---

<Site
	title="Reqly: see what your apps send and receive"
	description="Reqly is a free, open-source traffic inspector for the Mac and Windows. Every request your apps make, clearly laid out, in a native app."
>
	<section class="hero">
		<div class="container">
			<img class="hero-icon" src={icon} alt="" width="112" height="112" />
			<h1>See what your apps send and receive.</h1>
			<p class="lead">
				Reqly is a free, open-source traffic inspector for the Mac and Windows. Every request your
				apps make, clearly laid out, in a native app.
			</p>
			{/* The download for the visitor's system, as Site.astro's head script works it out, and
			    both for anyone else. site.css hides what isn't for the visitor. */}
			<div class="buttons">
				<a class="button primary" href={links.mac} data-for="mac other">Download for Mac</a>
				<a
					class="button primary"
					href={links.windowsSetup}
					data-for="windows other"
					aria-describedby="hero-windows-note">Download the Windows beta</a
				>
				<a class="button secondary" href={links.github}>View on GitHub</a>
			</div>
			<p class="fine-print" data-for="mac">Free and open source&nbsp;· macOS&nbsp;26 or later&nbsp;· Signed and notarized</p>
			<p class="fine-print" data-for="windows">
				Free and open source&nbsp;· Windows&nbsp;11&nbsp;· <a href={links.windows}>What's in the beta</a>
			</p>
			<p class="fine-print" data-for="other">Free and open source&nbsp;· macOS&nbsp;26 or later&nbsp;· Windows&nbsp;11, in beta</p>
			<p class="fine-print" id="hero-windows-note" data-for="windows">
				The installer isn't signed yet, so Windows may warn you about it: click More info, then Run anyway.
			</p>
			<p class="fine-print" data-for="mac">On Windows 11? <a href="#get-reqly">Try the beta</a>.</p>
			<p class="fine-print" data-for="windows">On a Mac? <a href="#get-reqly">Get Reqly for Mac</a>.</p>
			<p class="fine-print" data-for="other">
				Reqly runs on a Mac or a Windows PC, and Linux comes next. Phones and tablets connect to it over Wi-Fi.
			</p>
			<div class="reel">
				<video
					controls
					preload="none"
					playsinline
					poster="/video/showreel-poster.webp"
					width="1280"
					height="720"
					aria-label="Reqly in one minute: a narrated tour of the Mac app"
				>
					<source src="/video/showreel.mp4" type="video/mp4" />
					<track kind="captions" src="/video/showreel.en.vtt" srclang="en" label="English" />
				</video>
				<button class="reel-play" type="button" hidden>
					<span class="reel-play-label">
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path d="M4.5 2.6v10.8a.6.6 0 0 0 .9.5l8.7-5.4a.6.6 0 0 0 0-1L5.4 2.1a.6.6 0 0 0-.9.5Z" fill="currentColor" />
						</svg>
						Watch Reqly in one minute
					</span>
				</button>
			</div>
		</div>
	</section>

	<section aria-labelledby="features">
		<div class="container">
			<h2 id="features" class="visually-hidden">Features</h2>
			<div class="features">
				{
					features.map((feature) => (
						<article class="feature">
							<h3>{feature.title}</h3>
							<p>{feature.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section aria-labelledby="privacy">
		<div class="container">
			<div class="panel">
				<h2 id="privacy" class="section-title">Your traffic stays on your computer.</h2>
				<p class="section-text">
					No account, no analytics, and Reqly never sends your traffic anywhere. On its own, it
					only checks GitHub for a newer version, and you can turn that off.
				</p>
			</div>
		</div>
	</section>

	<section aria-labelledby="open-source">
		<div class="container">
			<h2 id="open-source" class="section-title">Free and open source.</h2>
			<p class="section-text">
				Reqly is MIT-licensed and built in the open. Read the code, report a problem, or send a
				pull request.
			</p>
			<div class="buttons">
				<a class="button secondary" href={links.github}>View on GitHub</a>
			</div>
		</div>
	</section>

	<section aria-labelledby="coming-next">
		<div class="container">
			<h2 id="coming-next" class="section-title">Coming next</h2>
			<div class="next">
				{
					next.map((item) => (
						<article class="feature">
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))
				}
			</div>
			<p class="center"><a href={links.roadmap}>See the roadmap</a></p>
		</div>
	</section>

	{/* Both systems for everyone. Only the buttons' emphasis follows the visitor's system: the
	    other one's button is a quiet one (site.css, data-quiet-on). */}
	<section class="get center" aria-labelledby="get-reqly">
		<div class="container">
			<h2 id="get-reqly" class="section-title">Get Reqly</h2>
			<div class="get-cards">
				<article class="get-card" aria-labelledby="get-mac">
					<h3 id="get-mac">Mac</h3>
					<a class="button primary" href={links.mac} data-quiet-on="windows">Download for Mac</a>
					<p class="or">or, with Homebrew:</p>
					<code class="command">{links.homebrew}</code>
					<p class="fine-print">macOS 26 or later. Signed and notarized. Reqly keeps itself up to date.</p>
				</article>
				<article class="get-card" aria-labelledby="get-windows">
					<h3 id="get-windows">Windows <span class="tag">Beta</span></h3>
					<a
						class="button primary"
						href={links.windowsSetup}
						data-quiet-on="mac"
						aria-describedby="get-windows-note">Download the Windows beta</a
					>
					<p class="fine-print">
						Windows 11. Installs for your account only, without administrator rights. Reqly keeps
						itself up to date.
					</p>
					<p class="fine-print" id="get-windows-note">
						The installer isn't signed yet, so Windows may warn you about it: click More info, then
						Run anyway.
					</p>
					<p class="fine-print"><a href={links.windows}>What's in the beta</a></p>
				</article>
			</div>
		</div>
	</section>
</Site>

<script>
	// Until it's played, the showreel shows one clear button over its still instead of the
	// player's controls. Without scripts, the player's own controls play it.
	const video = document.querySelector<HTMLVideoElement>('.reel video');
	const play = document.querySelector<HTMLButtonElement>('.reel-play');
	if (video && play) {
		video.controls = false;
		play.hidden = false;
		play.addEventListener('click', () => {
			play.hidden = true;
			video.controls = true;
			video.focus();
			void video.play();
		});
	}
</script>
