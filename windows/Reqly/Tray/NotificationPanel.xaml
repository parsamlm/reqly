<Window
    x:Class="Reqly.Tray.NotificationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reqly">
  <!-- The panel that opens from Reqly's icon in the notification area, as the Mac's menu-bar panel
       does: capturing at a glance, with a switch to start and stop it, the toolbar's other switches,
       and what Reqly can capture, in the Capture menu's words. -->
  <Grid x:Name="Root" Padding="4" KeyDown="OnKeyDown">
    <Grid.Resources>
      <!-- An action in the panel, which fills in under the pointer as a menu's items do. -->
      <Style x:Key="PanelItemStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                      <VisualState.Setters>
                        <Setter Target="Surface.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <VisualState.Setters>
                        <Setter Target="Surface.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                        <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                      <VisualState.Setters>
                        <Setter Target="Presenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                      </VisualState.Setters>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PanelDividerStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
      </Style>
      <!-- A row with a switch at its end, as tall as an action. -->
      <Style x:Key="PanelRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="MinHeight" Value="36" />
      </Style>
      <Style x:Key="ValueTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Grid.Resources>
    <StackPanel XYFocusKeyboardNavigation="Enabled">
      <Grid Padding="12,10,0,8" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="AppIcon" Width="32" Height="32" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Reqly" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <!-- No On and Off beside it: the status says. -->
        <ToggleSwitch x:Name="CaptureSwitch" Grid.Column="2" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                      Toggled="OnCaptureToggled" AutomationProperties.Name="Capturing" />
      </Grid>
      <TextBlock x:Name="ProblemText" Margin="12,0,12,8" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
      <Rectangle Style="{StaticResource PanelDividerStyle}" />

      <StackPanel Padding="12,6" Spacing="3">
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" />
        <Grid x:Name="Newest" ColumnSpacing="6" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Width="12" Height="12" VerticalAlignment="Center">
            <Ellipse x:Name="NewestDot" Width="7" Height="7" />
            <FontIcon x:Name="NewestFailed" Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="NewestCode" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock x:Name="NewestAddress" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="NoTrafficText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Rectangle Style="{StaticResource PanelDividerStyle}" />

      <Grid Style="{StaticResource PanelRowStyle}">
        <TextBlock Text="Breakpoints" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <ToggleSwitch x:Name="BreakpointsSwitch" Tag="breakpoint" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"
                      OnContent="" OffContent="" Toggled="OnRuleKindToggled" AutomationProperties.Name="Breakpoints" />
      </Grid>
      <Grid Style="{StaticResource PanelRowStyle}">
        <TextBlock Text="Slow Network" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <ToggleSwitch x:Name="SlowNetworkSwitch" Tag="slowNetwork" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0"
                      OnContent="" OffContent="" Toggled="OnRuleKindToggled" AutomationProperties.Name="Slow Network" />
      </Grid>
      <Rectangle Style="{StaticResource PanelDividerStyle}" />

      <Button x:Name="DecryptHttpsItem" Style="{StaticResource PanelItemStyle}" Click="OnDecryptHttpsClicked" AutomationProperties.Name="Decrypt HTTPS…">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Decrypt HTTPS…" VerticalAlignment="Center" />
          <TextBlock x:Name="DecryptedHostsText" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
        </Grid>
      </Button>
      <Button Style="{StaticResource PanelItemStyle}" Click="OnDevicesClicked" Content="Devices…" />
      <Rectangle Style="{StaticResource PanelDividerStyle}" />

      <Button Style="{StaticResource PanelItemStyle}" Click="OnOpenClicked" Content="Open Reqly" />
      <Button Style="{StaticResource PanelItemStyle}" Click="OnSettingsClicked" Content="Settings…" />
      <!-- Once an update has downloaded, as the Mac's panel offers it. -->
      <Button x:Name="UpdateItem" Style="{StaticResource PanelItemStyle}" Click="OnUpdateClicked" Visibility="Collapsed" />
      <Rectangle Style="{StaticResource PanelDividerStyle}" />

      <Button Style="{StaticResource PanelItemStyle}" Click="OnQuitClicked" Content="Quit Reqly" />
    </StackPanel>
  </Grid>
</Window>
