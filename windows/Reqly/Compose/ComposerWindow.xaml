<Window
    x:Class="Reqly.Compose.ComposerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inspector="using:Reqly.Inspector"
    Title="New request">
  <!-- A request to write and send. Its response shows beside it, and the list records it too. -->
  <Grid x:Name="Root" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="420" />
      <ColumnDefinition Width="460" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Padding="12" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="Method" MinWidth="100" AutomationProperties.Name="Method" />
        <TextBox x:Name="Address" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" PlaceholderText="https://api.example.com/path"
                 KeyDown="OnAddressKeyDown" AutomationProperties.Name="URL" />
        <Button x:Name="SendButton" Grid.Column="2" Content="Send" Style="{StaticResource AccentButtonStyle}" Click="OnSendClicked"
                ToolTipService.ToolTip="Send (Ctrl+Enter)" />
      </Grid>
      <StackPanel x:Name="ProblemLine" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="12,0,12,10" Visibility="Collapsed">
        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock x:Name="ProblemText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
        <StackPanel Padding="20" Spacing="24">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
              <TextBlock Text="Headers" Style="{ThemeResource BodyStrongTextBlockStyle}" />
              <TextBlock x:Name="HeaderCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="HeaderRows" Spacing="6" />
            <Button Content="Add header" Margin="0,8,0,0" Click="OnAddHeaderClicked" />
            <TextBlock Text="Reqly sets Host and Content-Length from the URL and the body." Margin="0,6,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Body" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
            <TextBox x:Name="BodyText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="200" FontFamily="Cascadia Mono, Consolas"
                     FontSize="12" AutomationProperties.Name="Body" />
            <StackPanel x:Name="BinaryLine" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
              <TextBlock x:Name="BinaryText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <Button Content="Remove body" Click="OnRemoveBodyClicked" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <Grid>
        <inspector:InspectorView x:Name="Response" Visibility="Collapsed" />
        <StackPanel x:Name="NothingSent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="24" MaxWidth="360">
          <FontIcon Glyph="&#xE724;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock HorizontalAlignment="Center" Text="Nothing sent yet" Style="{ThemeResource SubtitleTextBlockStyle}" />
          <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Text="Send the request to see its response here. Reqly records it in the list too."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
