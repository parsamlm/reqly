<Window
    x:Class="Reqly.Help.OpenSourceLicensesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:help="using:Reqly.Help"
    Title="Open-source licenses">
  <!-- The licenses of the open-source packages inside Reqly, in full, as on the Mac: the packages
       on the left, and the chosen one's license and notices on the right. -->
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24,20,24,24" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Open-source licenses" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBlock Text="Reqly includes code from these open-source packages, each under its own license." TextWrapping="Wrap"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
    <TextBlock x:Name="MissingText" Grid.Row="1" Text="Reqly couldn't find its list of open-source licenses." Visibility="Collapsed"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Border x:Name="Box" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="230" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListView x:Name="Packages" SelectionMode="Single" Padding="0,4" SelectionChanged="OnPackageChosen"
                  AutomationProperties.Name="Open-source packages">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="help:OpenSourcePackage">
              <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Spoken}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Version}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <Rectangle Grid.Column="1" Width="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <ScrollViewer x:Name="Scroller" Grid.Column="2" Padding="20,16,20,20">
          <StackPanel x:Name="Details" Spacing="16" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
