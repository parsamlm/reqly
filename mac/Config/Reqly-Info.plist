<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Xcode builds the rest of the app's Info.plist from build settings. This file adds what build
     settings can't hold: the files Reqly opens, and where Sparkle finds updates. -->
<plist version="1.0">
<dict>
	<!-- Sparkle installs new versions in place, from the appcast each release publishes. It's on
	     only in a copy built with the public half of the key that signs updates, which the release
	     workflow passes as the SPARKLE_PUBLIC_KEY build setting.
	     Other copies, such as Xcode's, say when a new version is on GitHub. -->
	<key>SUFeedURL</key>
	<string>https://github.com/parsamlm/reqly/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Reqly Session</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.reqly.session</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HTTP Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.reqly.har</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.reqly.session</string>
			<key>UTTypeDescription</key>
			<string>Reqly Session</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>reqly</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>net.reqly.har</string>
			<key>UTTypeDescription</key>
			<string>HTTP Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>har</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
